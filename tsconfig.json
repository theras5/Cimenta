{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@cimenta/dtos": [
        "packages/dtos/src"
      ],
      "@cimenta/utils": [
        "packages/utils/src"
      ]
    }
  },
  "include": [
    "apps/**/*",
    "server/**/*",
    "packages/**/*",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
}
